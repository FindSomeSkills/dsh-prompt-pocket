{
  "name": "dsh-prompt-pocket",
  "version": "1.0.16",
  "private": false,
  "type": "module",
  "description": "A prompt pocket that floats in the corner: save the draft or the selected text with Ctrl+Shift+S, click a saved prompt to drop it back at the caret.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json",
    "./docs/*": "./docs/*"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs/DETAIL.md",
    "docs/DETAIL.zh.md",
    "docs/shot.png",
    "scripts/smoke.mjs",
    "scripts/client-smoke.mjs",
    "scripts/docs-check.mjs",
    "scripts/verify.mjs",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "prompt",
    "prompt-library",
    "snippet",
    "plugin",
    "cordis",
    "dsh-plugin"
  ],
  "author": "YG",
  "homepage": "https://www.dshtoolbox.com/",
  "scripts": {
    "smoke": "node scripts/smoke.mjs",
    "smoke:client": "node scripts/client-smoke.mjs",
    "docs": "node scripts/docs-check.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FindSomeSkills/dsh-prompt-pocket"
  }
}
